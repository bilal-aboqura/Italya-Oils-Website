// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==========================================
// Category: Grouping entity for products
// ==========================================
model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("categories")
}

// ==========================================
// Product: Core entity for engine oil items
// ==========================================
model Product {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  sku               String    @unique
  name              String
  description       String?
  price             Float                    // سعر البيع
  brand             String?
  viscosity         String?                  // KM
  imageUrl          String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Extra columns from Excel
  totalQuantity     Float?                   // إجمالى الكمية
  avgPurchasePrice  Float?                   // متوسط سعر الشراء
  lastPurchasePrice Float?                   // آخر سعر شراء
  barcode           String?                  // باركود
  itemCode          String?                  // كود الصنف 1
  countryOfOrigin   String?                  // بلد المنشاءة
  unit              String?                  // الوحدة

  categoryId        String?   @db.ObjectId
  category          Category? @relation(fields: [categoryId], references: [id])

  @@map("products")
}

// ==========================================
// PromoBanner: Dynamic marketing banners
// ==========================================
model PromoBanner {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  imageUrl    String
  linkUrl     String?
  targetPage  String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("promo_banners")
}
