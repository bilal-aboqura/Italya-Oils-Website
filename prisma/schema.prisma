// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==========================================
// Category: Grouping entity for products
// ==========================================
model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    ProductCategory[]

  @@map("categories")
}

// ==========================================
// Product: Core entity for engine oil items
// ==========================================
model Product {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  sku               String    @unique
  name              String
  description       String?
  price             Float                    // سعر البيع
  salePrice         Float?                   // سعر البيع بعد الخصم (null = لا خصم)
  isOnSale          Boolean   @default(false)
  brand             String?
  viscosity         String?                  // KM
  imageUrl          String?
  isActive          Boolean   @default(true)
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Extra columns from Excel
  totalQuantity     Float?                   // إجمالى الكمية
  avgPurchasePrice  Float?                   // متوسط سعر الشراء
  lastPurchasePrice Float?                   // آخر سعر شراء
  barcode           String?                  // باركود
  itemCode          String?                  // كود الصنف 1
  countryOfOrigin   String?                  // بلد المنشاءة
  unit              String?                  // الوحدة

  categories        ProductCategory[]

  @@map("products")
}

// ==========================================
// ProductCategory: Many-to-many join table
// ==========================================
model ProductCategory {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  productId  String   @db.ObjectId
  categoryId String   @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@unique([productId, categoryId])
  @@map("product_categories")
}

// ==========================================
// PromoBanner: Dynamic marketing banners
// ==========================================
model PromoBanner {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  imageUrl    String
  linkUrl     String?
  targetPage  String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("promo_banners")
}

// ==========================================
// CountdownBanner: Bottom promotional banner with timer
// ==========================================
model CountdownBanner {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String   @default("خصومات ما تتفوت")
  subtitle    String   @default("استمتع بخصومات مميزة على مختلف المنتجات طوال العام")
  imageUrl    String?
  buttonText  String   @default("تسوق الآن")
  buttonLink  String   @default("/?section=products")
  endsAt      DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("countdown_banners")
}

// ==========================================
// Review: Customer reviews for the store
// ==========================================
model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  content   String
  rating    Int      @default(5)  // 1-5 stars
  status    String   @default("pending")  // pending | approved | rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews")
}

// ==========================================
// BrandLogo: Logos shown in the marquee strip
// ==========================================
model BrandLogo {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  logoUrl   String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("brand_logos")
}
