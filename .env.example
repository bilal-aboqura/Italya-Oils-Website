# ─────────────────────────────────────────────────────────────────
#  ItalyaOils — Environment Variables
#  Copy this file to .env and fill in the values before deploying.
# ─────────────────────────────────────────────────────────────────

# MongoDB connection string (e.g. MongoDB Atlas)
DATABASE_URL="mongodb+srv://<user>:<password>@cluster.mongodb.net/italyaoils?retryWrites=true&w=majority"

# WhatsApp number to receive orders (no + prefix, e.g. 966512345678)
NEXT_PUBLIC_WHATSAPP_NUMBER="966500000000"

# Cloudinary — for product image uploads
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Admin panel secret URL segment
# Example: if set to "my-secret-admin", admin is at /my-secret-admin
# ⚠️  Never use NEXT_PUBLIC_ here — must remain server-only
ADMIN_SECRET_PATH="change-me-to-something-secret"
